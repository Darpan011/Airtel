{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Udyam Digital (F5)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "jinja": true,
      "justMyCode": false
    },
    {
      "name": "Run current test file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
