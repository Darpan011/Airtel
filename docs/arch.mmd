subgraph EXT[" INTELLIGENCE &amp; REGISTRIES "]
  LLM["<b>Gemini 2.0 Flash</b><br/>understands the reply<br/>writes the pitch<br/><b><i>never selects products</i></b><br/>deterministic fallback<br/><i>llm.py</i>"]
